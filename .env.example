# Cloudinary unsigned upload — used by the portrait "Send to phone" action.
#
# Create an unsigned upload preset scoped to video uploads:
#   Cloudinary Console → Settings → Upload → Upload presets → Add upload preset
#   → Signing mode: Unsigned
#
# Never put the Cloudinary API secret in this file; the client only ever uses
# these two public values.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-video-preset
